# =============================================================================
# AirPurify AI — Unified Git Ignore Rules (Frontend, Backend & IoT)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Environment Variables, Secrets & Credentials (CRITICAL SECURITY)
# -----------------------------------------------------------------------------
.env
.env.*
*.env
*credentials*.env
atlas-credentials.env
credentials.json
client_secret*.json
*.pem
*.key
*.crt
*.pfx
*.p12
*.cer
id_rsa
id_ed25519

# Allow environment templates and examples
!.env.example
!backend/.env.example
!.env.template

