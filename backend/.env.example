# =============================================================================
# AirPurify AI — Backend Environment Configuration Template
# =============================================================================
# Copy this file to .env for local configuration:
#   cp .env.example .env

# --- Application Settings ---
APP_NAME="AirPurify AI"
APP_ENV="development"                # Options: development | production | test
APP_VERSION="1.0.0"
DEBUG=false                          # MUST be false in production to prevent stack trace leaks

# --- Server & Networking ---
HOST="127.0.0.1"
PORT=8001
# In production, specify exact frontend domains (no wildcards):
CORS_ORIGINS="http://localhost:8443,http://127.0.0.1:8443,http://localhost:5173,http://127.0.0.1:5173"

# --- Database Configuration ---
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.9tdvmma.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="airpurify_db"
DATABASE_URL="sqlite:///./airpurify.db" # Optional legacy fallback

# --- Security & Authentication Secrets ---
# In production, generate cryptographically secure 32+ character keys:
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRPURIFY_API_KEY="airpurify-dev-key-2026"
AIRPURIFY_ADMIN_KEY="airpurify-admin-dev-key-2026"

# --- Rate Limiting & Denial of Service Protection ---
MAX_PAYLOAD_BYTES=1048576             # 1 MB maximum upload size limit

# --- Sensor & Alert Thresholds ---
STALE_DATA_THRESHOLD_MINUTES=15
PM25_WARNING_THRESHOLD=35.0          # Moderate air quality threshold (ug/m3)
PM25_CRITICAL_THRESHOLD=55.0         # Unhealthy air quality threshold (ug/m3)
PM10_WARNING_THRESHOLD=54.0
PM10_CRITICAL_THRESHOLD=154.0

# --- Deep Learning Forecasting Pipeline ---
ENABLE_FORECASTING_MODEL=true
MODEL_NAME="1D-CNN-BiGRU"
MODEL_VERSION="v1.0-hybrid"
ML_ARTIFACTS_DIR="./ml/artifacts"

